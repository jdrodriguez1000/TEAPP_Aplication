# Copia este archivo como .env y pon tus valores reales.
# .env está en .gitignore y NUNCA se sube al repositorio.

# La llave de Claude. Sin ella el tutor no arranca: se niega a juzgar frases.
#
# 🚨 Es la única variable de este archivo que no empieza por `TEAPP_`, y no es un
# descuido: el nombre lo elige el SDK de Anthropic. Renombrarla la haría
# invisible.
#
# 💰 Es la única que cuesta dinero. Cada frase que alguien escriba se paga.
# Se saca de la consola de Anthropic y empieza por `sk-ant-`.
ANTHROPIC_API_KEY=

# La llave con la que el servidor firma las sesiones (paso 5).
#
# Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# ⚠️ Si esta llave cambia, TODAS las sesiones abiertas dejan de valer de golpe y
# todo el mundo tiene que volver a entrar. No es un fallo: es cómo funciona una
# firma. Ver [A-008].
TEAPP_SECRET_KEY=

# Dónde viven los datos de las personas: cuentas, marcadores y cuota (paso 7).
#
# 🚨 Va VACÍO a propósito, igual que la llave de arriba y por la misma razón: un
# ejemplo que funciona sin editarlo es un valor por defecto disfrazado. Nadie lo
# cambia, y el día que este archivo se copie tal cual en el servidor, la app
# escribiría los datos de las personas junto al código. Ver [D-037].
#
# ⚠️ Tiene que ser una ruta ABSOLUTA. Una relativa se resuelve contra la carpeta
# desde la que se lanzó el proceso, así que el mismo programa escribiría en
# sitios distintos según desde dónde se arranque — que es justo lo que esta
# variable existe para eliminar. Una ruta relativa se RECHAZA, no se resuelve.
#
# ⚠️ Y la carpeta tiene que EXISTIR: la app no la crea. Si la creara, una ruta
# mal escrita se convertiría en una carpeta vacía y todo el mundo parecería haber
# perdido su marcador, sin un solo error. Créala tú la primera vez.
#
#   En Windows:  TEAPP_DATA_DIR=C:\ruta\hasta\TEAPP\data
#   En Linux:    TEAPP_DATA_DIR=/home/tu-usuario/TEAPP/data
#   En el servidor del paso 7, la escribe `deploy/install.sh`.
TEAPP_DATA_DIR=

# Si la cookie de sesión debe viajar solo por HTTPS. Por defecto es `true`, que
# es lo seguro y lo que hay que usar en la nube (paso 7).
#
# ⚠️ En local hay que ponerlo en `false`: el navegador DESCARTA EN SILENCIO una
# cookie `Secure` que llega por `http://localhost`, y el inicio de sesión
# parecería no hacer nada, sin ningún error. El servidor escribe en el log cuál
# de los dos modos tiene activo, justo para que eso no se busque a ciegas.
TEAPP_COOKIE_SECURE=false

# Si `/register` atiende por la red a quien no tiene cuenta. Por defecto `false`,
# que es lo cerrado y lo seguro (ver [D-027]).
#
# 🚨 Con esto abierto, cualquiera que llegue a la dirección puede crear cuentas,
# y CADA UNA cuesta un `scrypt` entero: 128 ms de CPU, ~16 MB de memoria y una
# reescritura completa del archivo de todas las cuentas. Medido el 2026-08-04.
#
# ⚠️ Se exige la palabra exacta `true` para abrir. Un `yes` o un `1` NO abren:
# equivocarse aquí tiene que dejar la puerta cerrada, no abierta.
#
# Las cuentas se crean desde la terminal, sin tocar este interruptor:
#   TEAPP_NEW_PASSWORD='la-contrasena' python create_account.py <nombre>
TEAPP_REGISTRATION_OPEN=false
